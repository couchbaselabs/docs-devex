{
  "size": 10,
  "from": 0,
  "query": {
    "custom_score": {
      "query": {
        "custom_filter": {
          "query": {
            "match": "sea view"
          },
          "fields": ["price_per_night"],
          "params": {
            "stay_nights": 5,
            "budget": 2000
          },
          "source": "function within_budget(doc, params) { var price = doc.fields[\"price_per_night\"]; if (price === undefined) return false; return price * params.stay_nights <= params.budget; }"
        }
      },
      "fields": ["price_per_night", "distanceFromCenterKm"],
      "params": {},
      "source": "function prefer_cheap_central(doc, params) { var s = doc.score; var price = doc.fields[\"price_per_night\"]; var dist = doc.fields[\"distanceFromCenterKm\"]; if (price !== undefined) { if (price < 100) { s = s * 3; } else if (price <= 200) { s = s * 2; } } if (dist !== undefined) { if (dist <= 2) { s = s * 2; } else if (dist <= 5) { s = s * 1.5; } } return s; }"
    }
  }
}
