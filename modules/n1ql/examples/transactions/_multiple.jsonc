        "user": "0", // <.>
        "name": "Keon Hoppe"
      }
// end::check-3[]
    ]
  },
  {
    "batchQuery": "\n\n-- Commit the transaction\nCOMMIT TRANSACTION;",
    "batchQueryResult": []
  }
]
