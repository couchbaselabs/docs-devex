/* Data Control Language */

dcl-statement ::= grant
                | revoke

/* tag::grant[] */
grant ::= grant-roles | grant-credentialstore-privilege | grant-catalog-privilege
/* end::grant[] */

/* tag::grant-roles[] */
grant-roles ::= 'GRANT' role ( ',' role )*
              ( 'ON' keyspace-ref ( ',' keyspace-ref )* )?
                'TO' users-or-groups
/* end::grant-roles[] */

/* tag::grant-credentialstore-privilege[] */
grant-credentialstore-privilege ::= 'GRANT' 'CONSUME' 'CREDENTIALSTORE'
                                    'ON' credential ( ',' credential )*
                                    'TO' users-or-groups
/* end::grant-credentialstore-privilege[] */

/* tag::grant-catalog-privilege[] */
grant-catalog-privilege ::= 'GRANT' 'SELECT' 'CATALOG'
                            'ON' catalog ( ',' catalog )*
                            'TO' users-or-groups
/* end::grant-catalog-privilege[] */

/* tag::revoke[] */
revoke ::= revoke-roles | revoke-credentialstore-privilege | revoke-catalog-privilege
/* end::revoke[] */

/* tag::revoke-roles[] */
revoke-roles ::= 'REVOKE' role ( ',' role )* ( 'ON' keyspace-ref ( ',' keyspace-ref )* )?
                 'FROM' users-or-groups
/* end::revoke-roles[] */

/* tag::revoke-credentialstore-privilege[] */
revoke-credentialstore-privilege ::= 'REVOKE' 'CONSUME' 'CREDENTIALSTORE'
                                     'ON' credential ( ',' credential )*
                                     'FROM' users-or-groups
/* end::revoke-credentialstore-privilege[] */

/* tag::revoke-catalog-privilege[] */
revoke-catalog-privilege ::= 'REVOKE' 'SELECT' 'CATALOG'
                             'ON' catalog ( ',' catalog )*
                             'FROM' users-or-groups
/* end::revoke-catalog-privilege[] */

/* tag::users-or-groups[] */
users-or-groups ::= ( ( 'USER' | 'USERS' )? user ( ',' user )*
                    | ( 'GROUP' | 'GROUPS' ) group ( ',' group )* )
/* end::users-or-groups[] */

role ::= identifier
user ::= identifier
group ::= identifier
credential ::= identifier